rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function logado() { return request.auth != null; }
    function eu(uid) { return logado() && request.auth.uid == uid; }

    // Nome e cor de cada um: os dois leem, cada um altera só o seu
    match /membros/{uid} {
      allow read: if logado();
      allow write: if eu(uid);
    }

    // Totais do mês de cada um (o que o outro enxerga)
    match /resumos/{uid} {
      allow read: if logado();
      allow write: if eu(uid);
    }

    // Lançamentos individuais: só o próprio dono lê e escreve
    match /usuarios/{uid}/{doc=**} {
      allow read, write: if eu(uid);
    }

    // Despesas do casal e cofrinho: os dois leem; cada um cria, altera e exclui só o que lançou
    match /conjunto/{id} {
      allow read: if logado();
      allow create: if logado() && request.resource.data.autor == request.auth.uid;
      allow update: if logado() && resource.data.autor == request.auth.uid && request.resource.data.autor == request.auth.uid;
      allow delete: if logado() && resource.data.autor == request.auth.uid;
    }
    match /cofrinho/{id} {
      allow read: if logado();
      allow create: if logado() && request.resource.data.autor == request.auth.uid;
      allow update: if logado() && resource.data.autor == request.auth.uid && request.resource.data.autor == request.auth.uid;
      allow delete: if logado() && resource.data.autor == request.auth.uid;
    }

    // Configurações do casal, meta da viagem e acertos do mês
    match /config/{id} {
      allow read, write: if logado();
    }
    match /acertos/{mes} {
      allow read, write: if logado();
    }
  }
}
